[Unit]
Description=Show the existing XRDP desktop through RealVNC Service Mode
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=%h/scripts/realvnc-current-xrdp-desktop.sh run
# The Viewer is the console-to-XRDP relay. If it is closed normally, restore
# it as well so RealVNC Service Mode cannot fall back to the separate :0
# desktop.
Restart=always
RestartSec=10
TimeoutStopSec=8
KillMode=control-group

[Install]
WantedBy=default.target
